{
  "$description": "Kopi design system tokens (W3C DTCG format). Single source of truth: edit here, then regenerate platform code.",
  "$extensions": {
    "designku": {
      "id": "kopi",
      "name": "Kopi",
      "letter": "F",
      "group": "commerce",
      "context": "Food and beverage, cafes, restaurants, travel, lifestyle, hospitality",
      "tagline": "Warm, tactile and appetizing — a menu, not a dashboard.",
      "audience": "Customers ordering or browsing at leisure; emotional, sensory decisions driven by photography.",
      "personality": [
        "warm",
        "crafted",
        "inviting",
        "unpretentious"
      ],
      "rationale": {
        "color": "Roasted-coffee brown is earthy and appetizing and, unlike saturated red or orange, never fights with food photography. Matcha-olive secondary supports fresh and plant-based cues; caramel-saffron tertiary highlights specials. Neutrals are a warm cream (higher chroma, hue 75) instead of clinical white, like paper or linen.",
        "typography": "Fraunces, a soft old-style serif, gives headlines the feel of a printed menu. DM Sans body keeps prices and options clean and modern.",
        "shape": "Soft 8-16px corners, comfortable density. Cards are image-first with generous padding.",
        "motion": "Balanced and gentle; image fades and sheet transitions use the slow duration."
      },
      "do": [
        "Let photography carry the color; keep chrome on cream surfaces.",
        "Use headline styles (serif) for dish and place names, body (sans) for descriptions and prices.",
        "Use tertiaryContainer for 'new' and 'chef's pick' labels."
      ],
      "dont": [
        "Do not set long paragraphs in the serif display family — it is for headlines only.",
        "Do not place text directly on photos without a scrim.",
        "Do not use pure white cards; surfaceContainerLowest is the brightest surface and should be used sparingly."
      ],
      "schemaVersion": 1,
      "spec": {
        "primary": "#7A4B2A",
        "secondary": "#6B7A3A",
        "tertiary": "#C27A1A",
        "neutralHue": 75,
        "neutralChroma": 0.014,
        "error": "#B3123F",
        "success": "#1E8E3E",
        "warning": "#B26A00",
        "info": "#0B6BCB",
        "mood": "warm",
        "fonts": {
          "display": "Fraunces",
          "body": "DM Sans",
          "mono": "JetBrains Mono"
        },
        "type": {
          "displayWeight": 600,
          "headlineWeight": 600,
          "titleWeight": 600,
          "labelWeight": 600,
          "bodyWeight": 400,
          "displayTracking": -0.6
        },
        "corner": "soft",
        "density": "comfortable",
        "motion": "balanced",
        "elevation": "soft",
        "darkStyle": "tinted",
        "contrast": "AA",
        "tones": {
          "light": {},
          "dark": {}
        }
      },
      "fonts": {
        "display": "Fraunces",
        "body": "DM Sans",
        "mono": "JetBrains Mono"
      }
    }
  },
